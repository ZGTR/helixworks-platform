{
  "name": "helixworks-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run build --filter=@helixworks/service-kit... && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke:product": "turbo run build --filter=@helixworks/service-kit... && tsx tests/smoke-product.ts"
  },
  "devDependencies": {
    "@helixworks/contracts": "workspace:*",
    "@helixworks/service-kit": "workspace:*",
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "esbuild": "0.25.12",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
